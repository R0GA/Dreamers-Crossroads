--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Sequence_7_KaraokeRoomEntrance
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Pixie
    text: The jukebox has the song but it's all jumbled.
    voiceClip: {fileID: 0}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 2
  - speakerName: Pixie
    text: 'Chelsea knows every single note of this. She could hum it in her sleep.

'
    voiceClip: {fileID: 0}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 2
  - speakerName: Pixie
    text: 'She literally is. She literally is humming it in her sleep right now.

'
    voiceClip: {fileID: 0}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 2
  - speakerName: Sandman
    text: 'We need to find the right order and play it back.

'
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 2
  - speakerName: Pixie
    text: Exactly! The jukebox will play a sequence and you have to- you have to
      listen and then repeat it back in the right order.
    voiceClip: {fileID: 0}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 4
  playOnce: 0

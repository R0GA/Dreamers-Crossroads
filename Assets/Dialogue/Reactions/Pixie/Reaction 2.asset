  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Reaction 2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Pixie
    text: "You\u2019re back! Are you back? You look back."
    voiceClip: {fileID: 8300000, guid: 3e65035f96598714f990ffbb9f174ea0, type: 3}
    portrait: {fileID: 498091447, guid: 767384ce198e61a48aeac2c0b6186efa, type: 3}
    autoAdvanceDelay: 3.5
  - speakerName: Sandman
    text: "I\u2019m back."
    voiceClip: {fileID: 8300000, guid: 3107747cd81cbab429ecdb68d9d7050a, type: 3}
    portrait: {fileID: 1468311074, guid: aa0a489ea077dc44593563eeb62c541b, type: 3}
    autoAdvanceDelay: 1.5
  - speakerName: Pixie
    text: "Good. Great. Don\u2019t do that again."
    voiceClip: {fileID: 8300000, guid: c70c67e54a4844c4d81fd128180f33cc, type: 3}
    portrait: {fileID: 498091447, guid: 767384ce198e61a48aeac2c0b6186efa, type: 3}
    autoAdvanceDelay: 2.5
  - speakerName: Sandman
    text: "I\u2019ll do my best."
    voiceClip: {fileID: 8300000, guid: 8d1c4c1a08e970540831dce177761b6f, type: 3}
    portrait: {fileID: 1468311074, guid: aa0a489ea077dc44593563eeb62c541b, type: 3}
    autoAdvanceDelay: 2
  playOnce: 0

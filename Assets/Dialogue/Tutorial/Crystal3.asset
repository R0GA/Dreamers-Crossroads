  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Crystal3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Sandman
    text: Now thats what im talkin' about...
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 4
  - speakerName: Sandman
    text: Feels like my catchers fully operational again.
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 5
  - speakerName: Sandman
    text: Damn, I'm getting more about that dream too now, it seems Sir Knightmares
      beaten me there already.
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 8
  - speakerName: Sandman
    text: Guess I've gotta be hasty, thankfully I've got my launch back.
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 5
  - speakerName: 
    text: 'Tip: When on the ground, press and hold right click to charge up a launch
      in the direction you''re facing.'
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    autoAdvanceDelay: 10
  playOnce: 1

  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Sequence12 Approach
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Pixie
    text: "Oh my! Are those Chelsea\u2019s dream fragments?"
    voiceClip: {fileID: 8300000, guid: a7833d0f92a0322428b7b9ce246d7e44, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 3
  - speakerName: Sandman
    text: "Yup. He\u2019s eating them."
    voiceClip: {fileID: 8300000, guid: a31979508dafbe34d9640ce017e7c365, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 2
  - speakerName: Pixie
    text: "That\u2019s horrible! Don\u2019t just stand there. Do something!"
    voiceClip: {fileID: 8300000, guid: 77a22fb8154547843b996a810afaba7d, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 3
  - speakerName: Sandman
    text: "I know I know. I need to swing through them to get to them before he can.
      If I starve him of enough, I should be able to expose his heart. Once he\u2019s
      exposed, we finish this."
    voiceClip: {fileID: 8300000, guid: 82591330988940d48983457efe493806, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 11
  playOnce: 0

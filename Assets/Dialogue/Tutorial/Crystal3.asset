  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Crystal3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Sandman
    text: Now thats what im talkin' about...
    voiceClip: {fileID: 8300000, guid: 30d3ee997a5b1cc47bdbbcfab5b8c692, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 2.5
  - speakerName: Sandman
    text: Feels like my catchers fully operational again.
    voiceClip: {fileID: 8300000, guid: 2088687d0245ff8468a9884082f13087, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 3.5
  - speakerName: Sandman
    text: Seems Sir Knightmares beaten me there already.
    voiceClip: {fileID: 8300000, guid: 13fb2cc69d61fef4d99a0c9a31787eca, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 3.5
  - speakerName: Sandman
    text: Well, let's not dawdle.
    voiceClip: {fileID: 8300000, guid: b066039d70bad234d93fc28d9a6f12cb, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 5
  - speakerName: 
    text: 'Tip: When on the ground, press and hold right click to charge up a launch
      in the direction you''re facing.'
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    autoAdvanceDelay: 10
  playOnce: 1

%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Sequence2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Pixie
    text: "Oh! OH! You're here, you're actually here, I've been waiting and waiting
      and \u2014 are you the Sandman? You look like the Sandman. You have to be the
      Sandman. Please be the Sandman."
    voiceClip: {fileID: 8300000, guid: afd90bb50f46c804d83d804827e983f7, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 9
  - speakerName: Pixie
    text: OKAY. Okay okay okay. We have a situation. Several situations actually.
      Have you seen this place? It's- well it's supposed to be wonderful, it's supposed
      to be Chelsea's BEST birthday, I've been trying to hold it together but something
      got in here and now everything is- have you noticed the floor? Don't look at
      the floor it'll stress you out.
    voiceClip: {fileID: 8300000, guid: ddcb595df08f0a04eb7ac7e09b358000, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 16
  - speakerName: Sandman
    text: I noticed the floor.
    voiceClip: {fileID: 8300000, guid: 6525ca9668bd97d4497e846b2a27a77f, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 2.5
  - speakerName: Pixie
    text: It's fine. It's fine. You're here now... It IS going to be fine. Right?
    voiceClip: {fileID: 8300000, guid: c7829714a637e394ebb46ce75495e5c0, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 6.5
  - speakerName: Sandman
    text: That's what I'm here for.
    voiceClip: {fileID: 8300000, guid: e514add3bacbcdc47b4c44a62e9727a6, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 1.5
  - speakerName: Sandman
    text: "It doesn\u2019t look like there\u2019s much left to cross. Its just three
      sections. Let\u2019s take them one at a time then we get you home."
    voiceClip: {fileID: 8300000, guid: aa47f8a2209e67f428231c1b6d02a438, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 7.5
  - speakerName: Pixie
    text: "Three! Just three? That\u2019s nothing. Three is manageable. Three is
      practically lucky. Come on, let\u2019s go."
    voiceClip: {fileID: 8300000, guid: 5135f53bea11c2d4e95e4e3fb50312de, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 6.5
  - speakerName: Pixie
    text: "I should warn you, this dream is very Chelsea. And Chelsea, as you\u2019ll
      soon discover, does not do things by halves."
    voiceClip: {fileID: 8300000, guid: d95f04530ed3fca449b4de30bea3f6b5, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 6
  - speakerName: Sandman
    text: I can see that.
    voiceClip: {fileID: 8300000, guid: 7e5071b19fb4aa14f80315ba26f4612b, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 2
  playOnce: 0

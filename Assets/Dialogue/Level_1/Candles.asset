MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Candles
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Pixie
    text: Oh look! Candles! Chelsea loves candles!
    voiceClip: {fileID: 0}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 3
  - speakerName: Pixie
    text: Try lighting them, see what happens?
    voiceClip: {fileID: 0}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 3
  - speakerName: Sandman
    text: Alright... And what happens when they go out?
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 3
  - speakerName: Pixie
    text: Uhm... Do it again... And keep doing it until you get them all on.
    voiceClip: {fileID: 0}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 3
  - speakerName: Pixie
    text: I think they've got like an order or something.
    voiceClip: {fileID: 0}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 3
  playOnce: 1

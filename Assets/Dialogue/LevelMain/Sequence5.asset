  m_Name: Sequence5
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Pixie
    text: Oh no. This is Chelsea's dance floor. She loves this. She was so excited
      about this part and look at it, it's all-
    voiceClip: {fileID: 8300000, guid: 96a18c7319f1e184898f30d7e9fd3379, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 6.3
  - speakerName: Sandman
    text: Drained. Something's been at it.
    voiceClip: {fileID: 8300000, guid: 79df3340eb0721d4ba17960b0484d980, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 4
  - speakerName: Pixie
    text: Okay. Okay, we fix it. We just... How do we fix it?
    voiceClip: {fileID: 8300000, guid: f28dae5f01f30354b8c16bc214e2182f, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 4
  playOnce: 0

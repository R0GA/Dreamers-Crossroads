--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Sequence12 Phase2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Sir Knightmare
    text: "You\u2019re going to have to do better than a lullaby."
    voiceClip: {fileID: 8300000, guid: 6d1086b80c48c354ea5bc86cf4ad0637, type: 3}
    portrait: {fileID: 0}
    autoAdvanceDelay: 2.5
  - speakerName: Sandman
    text: "First time\u2019s never the last."
    voiceClip: {fileID: 8300000, guid: 3e47cd1d5ec77b64b99cabd554a1f00e, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 2.5
  - speakerName: Pixie
    text: "He\u2019s getting angry Sandman!"
    voiceClip: {fileID: 8300000, guid: 3945c33dea2d11e4fac2a7fcefaac1ca, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 2.5
  - speakerName: Sandman
    text: Good. Angry ones get sloppy. Keep your head down.
    voiceClip: {fileID: 8300000, guid: 86eb0d0161f0447499f874b371076851, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 4.5
  - speakerName: Sir Knightmare
    text: "You want to know the difference between us? I remember every dream I\u2019ve
      ever touched. Every single one. Can you say the same?"
    voiceClip: {fileID: 8300000, guid: 334e3eac255fb55408524704ca88e02b, type: 3}
    portrait: {fileID: 0}
    autoAdvanceDelay: 8.5
  - speakerName: Sandman
    text: "The difference between us is that you remember them because you ruined
      them. I let them go because they weren\u2019t mine to keep."
    voiceClip: {fileID: 8300000, guid: 50374ef7fe23f2042902e0e096f651d3, type: 3}
    portrait: {fileID: 0}
    autoAdvanceDelay: 7.5
  - speakerName: Sir Knightmare
    text: How noble.
    voiceClip: {fileID: 8300000, guid: f7760e2ce1988e4458f6091205d24525, type: 3}
    portrait: {fileID: 0}
    autoAdvanceDelay: 1.5
  playOnce: 0

--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Sequence12 Down
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Sir Knightmare
    text: "She won\u2019t remember any of this, you know. The girl. She\u2019ll wake
      up and it\u2019ll be gone. All of it. What you\u2019re doing right now? it
      disappears with the morning"
    voiceClip: {fileID: 8300000, guid: 4f4344c10bea2f54f91afb5125b81278, type: 3}
    portrait: {fileID: 1198445817, guid: ae9ba818ed86d054b837af2f23728201, type: 3}
    autoAdvanceDelay: 12
  - speakerName: Sandman
    text: "The feeling stays. Even when the dream doesn\u2019t."
    voiceClip: {fileID: 8300000, guid: 4249cbf66faf80f4d92ec70c1a0fcb1c, type: 3}
    portrait: {fileID: 1468311074, guid: aa0a489ea077dc44593563eeb62c541b, type: 3}
    autoAdvanceDelay: 4
  - speakerName: Sir Knightmare
    text: You tell yourself that.
    voiceClip: {fileID: 8300000, guid: d8598a66ab9da85449e261a8562ea32d, type: 3}
    portrait: {fileID: 1198445817, guid: ae9ba818ed86d054b837af2f23728201, type: 3}
    autoAdvanceDelay: 2
  - speakerName: Sandman
    text: "I\u2019ve seen it. Enough times to know."
    voiceClip: {fileID: 8300000, guid: 276ef25d22ab5c3408aa60db93115a84, type: 3}
    portrait: {fileID: 1468311074, guid: aa0a489ea077dc44593563eeb62c541b, type: 3}
    autoAdvanceDelay: 3.5
  playOnce: 0

  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Crystal1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Sandman
    text: Hm...
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 1.5
  - speakerName: Sandman
    text: Powers coming back to my catcher.
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 3
  - speakerName: Sandman
    text: It seems its reacting to something nearby too...
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 4
  - speakerName: Sandman
    text: A dream if I had to guess... A close one too.
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 4
  - speakerName: Sandman
    text: Funny time for one to turn up.
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 4
  - speakerName: 
    text: 'Tip: Use space to jump, jump just when landing to preserve momentum.'
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    autoAdvanceDelay: 8
  playOnce: 1

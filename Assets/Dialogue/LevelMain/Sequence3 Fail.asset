  m_Name: Sequence3 Fail
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Pixie
    text: "Oh! They turned off\u2026 That\u2019s super weird."
    voiceClip: {fileID: 8300000, guid: 726efe514e380c746a3c38d8f7f3a425, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 3.5
  - speakerName: Sandman
    text: "Weird indeed. I wonder if maybe there\u2019s a sequence to them."
    voiceClip: {fileID: 8300000, guid: e61801da5963b424a95cc3d3bad983e7, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 5
  - speakerName: Pixie
    text: Ooouu, a sequence. What's the sequence?
    voiceClip: {fileID: 8300000, guid: 5f05f27710589054d8eb50aee92166fe, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 3.5
  - speakerName: Sandman
    text: "If I knew that I wouldn't have got it wrong\u2026"
    voiceClip: {fileID: 8300000, guid: fc423a07233f75d42b59e46ea58d1128, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 4
  playOnce: 0

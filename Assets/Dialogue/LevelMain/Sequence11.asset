  lines:
  - speakerName: Pixie
    text: Oh.
    voiceClip: {fileID: 8300000, guid: cb41fb482baf10342a95139ff1662fec, type: 3}
    portrait: {fileID: 498091447, guid: 767384ce198e61a48aeac2c0b6186efa, type: 3}
    autoAdvanceDelay: 1
  - speakerName: Pixie
    text: He's actually here.
    voiceClip: {fileID: 8300000, guid: c338e3cd615b20549820ba146484afa7, type: 3}
    portrait: {fileID: 498091447, guid: 767384ce198e61a48aeac2c0b6186efa, type: 3}
    autoAdvanceDelay: 2.5
  - speakerName: Sandman
    text: Stay close. Stay behind me. Whatever he does, stay on the platforms.
    voiceClip: {fileID: 8300000, guid: 2d42155e5ebdb424896bdc3deef23975, type: 3}
    portrait: {fileID: 1468311074, guid: aa0a489ea077dc44593563eeb62c541b, type: 3}
    autoAdvanceDelay: 6
  playOnce: 0

  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Sequence8 Success
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Pixie
    text: There it is. That's Chelsea's mum's voice in that melody. Not really. But
      sort of.
    voiceClip: {fileID: 8300000, guid: b0484e11bdd21ab488c7ed9f85e04ae2, type: 3}
    portrait: {fileID: 498091447, guid: 767384ce198e61a48aeac2c0b6186efa, type: 3}
    autoAdvanceDelay: 5.5
  - speakerName: Sandman
    text: She's lucky. To have something that sounds like that when she's scared.
    voiceClip: {fileID: 8300000, guid: 42f7aefbf2309af4cafe24bbf125ba6d, type: 3}
    portrait: {fileID: 1468311074, guid: aa0a489ea077dc44593563eeb62c541b, type: 3}
    autoAdvanceDelay: 5
  - speakerName: Pixie
    text: 'Yeah... Okay! Next section! Let''s GO! '
    voiceClip: {fileID: 8300000, guid: 4a308e51c2acca34293b65c8b8ef6e59, type: 3}
    portrait: {fileID: 498091447, guid: 767384ce198e61a48aeac2c0b6186efa, type: 3}
    autoAdvanceDelay: 3
  playOnce: 0

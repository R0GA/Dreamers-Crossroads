  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Sequence3 Fail 2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Pixie
    text: Grrr! This is harder than I thought.
    voiceClip: {fileID: 8300000, guid: d7d7917adb67c70428afb96898bf633b, type: 3}
    portrait: {fileID: 498091447, guid: 767384ce198e61a48aeac2c0b6186efa, type: 3}
    autoAdvanceDelay: 2.5
  - speakerName: Sandman
    text: "You got that right. It's like the reverse of those candles that don\u2019t
      go out no matter how much you blow. But Chelsea Needs us!"
    voiceClip: {fileID: 8300000, guid: 8624686de96d2044d9530bf6785529a5, type: 3}
    portrait: {fileID: 1468311074, guid: aa0a489ea077dc44593563eeb62c541b, type: 3}
    autoAdvanceDelay: 7.5
  - speakerName: Pixie
    text: Chelsea does need us! We got this!
    voiceClip: {fileID: 8300000, guid: cd696c53bca0efd4e8b3ea95848a1df0, type: 3}
    portrait: {fileID: 498091447, guid: 767384ce198e61a48aeac2c0b6186efa, type: 3}
    autoAdvanceDelay: 3
  playOnce: 0

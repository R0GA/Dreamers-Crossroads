  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Sequence6 Success
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Pixie
    text: It's working! it's actually working! look at it, it's so PINK.
    voiceClip: {fileID: 8300000, guid: 6aff2a09557eb1c4e9fbf4a28b012199, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 3.5
  - speakerName: Sandman
    text: I need to get across to the next section. Without crossing a turned tile.
    voiceClip: {fileID: 8300000, guid: e0acef847c2c3764498feb81912e8563, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 6.5
  - speakerName: Pixie
    text: Oh! Oh you can use the disco ball! Grapple onto it and swing across!
    voiceClip: {fileID: 8300000, guid: fd54b59390a7fda47b7b280de5d54a71, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 4.5
  - speakerName: Sandman
    text: That's what I was going to do.
    voiceClip: {fileID: 8300000, guid: 4249b97935477b64192b7a4ea3056be4, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 2.5
  - speakerName: Pixie
    text: "I know! I'm just I'm saying it out loud because it's EXCITING! WHEEEEE
      \u2014 "
    voiceClip: {fileID: 8300000, guid: aa993ef6d451b7c45837ba4ec00f174e, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 3.5
  playOnce: 0

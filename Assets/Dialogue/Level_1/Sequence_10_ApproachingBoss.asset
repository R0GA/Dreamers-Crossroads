  lines:
  - speakerName: Pixie
    text: Oh.
    voiceClip: {fileID: 0}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 1
  - speakerName: Pixie
    text: He's actually here.
    voiceClip: {fileID: 0}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 2
  - speakerName: Sandman
    text: Oh boy he is.
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    autoAdvanceDelay: 1.5
  - speakerName: Sandman
    text: Stay close. Stay behind me. Whatever he does, stay on the platforms.
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 3
  - speakerName: Sandman
    text: He's going to make this difficult.
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 2
  playOnce: 0

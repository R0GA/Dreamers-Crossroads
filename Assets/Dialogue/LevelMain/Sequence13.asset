  lines:
  - speakerName: Pixie
    text: Is it done?
    voiceClip: {fileID: 8300000, guid: 4c68184c46886ba4dbc521423b46b5c8, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 2.5
  - speakerName: Sandman
    text: For tonight.
    voiceClip: {fileID: 8300000, guid: c3154b71a367bdc45b86ccbfaa81cf46, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 2
  - speakerName: Pixie
    text: You okay?
    voiceClip: {fileID: 8300000, guid: 0770bdbce5c41e24a890b43fb4a0a180, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 2.5
  - speakerName: Sandman
    text: Ask me in the morning.
    voiceClip: {fileID: 8300000, guid: cc9b8031860fda24d803291ec01d5384, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 2.5
  - speakerName: Sandman
    text: "Come on. Let\u2019s get you home."
    voiceClip: {fileID: 0}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 3
  playOnce: 0

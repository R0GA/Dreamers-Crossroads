--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95859aad02c7e564ba46f760c532221b, type: 3}
  m_Name: Sequence7
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Pixie
    text: Do you hear that? That's Chelsea's song.
    voiceClip: {fileID: 8300000, guid: 3137749d10e2a3446be4dbaaf61770e7, type: 3}
    portrait: {fileID: 498091447, guid: 767384ce198e61a48aeac2c0b6186efa, type: 3}
    autoAdvanceDelay: 3
  - speakerName: Sandman
    text: What do you mean?
    voiceClip: {fileID: 8300000, guid: a08c1ca648ebcdd429c3d390b236f8ce, type: 3}
    portrait: {fileID: 1468311074, guid: aa0a489ea077dc44593563eeb62c541b, type: 3}
    autoAdvanceDelay: 2
  - speakerName: Pixie
    text: "When Chelsea gets scared. Really scared. Her mum sings her this lullaby.
      Just this one specific song, every time. And somehow, it just makes everything
      feel\u2026 okay."
    voiceClip: {fileID: 8300000, guid: 74cdb584ee6022f4a8294140f0e1b6d4, type: 3}
    portrait: {fileID: 498091447, guid: 767384ce198e61a48aeac2c0b6186efa, type: 3}
    autoAdvanceDelay: 10
  - speakerName: Pixie
    text: It's in there. But it sounds scratchy and scrambled.
    voiceClip: {fileID: 8300000, guid: 43b3a4f7f4997d74dafee57f4e385c17, type: 3}
    portrait: {fileID: 498091447, guid: 767384ce198e61a48aeac2c0b6186efa, type: 3}
    autoAdvanceDelay: 4.5
  - speakerName: Sandman
    text: Then we unscramble it.
    voiceClip: {fileID: 8300000, guid: ddf99071099e18d4f87d31b29c209894, type: 3}
    portrait: {fileID: 1468311074, guid: aa0a489ea077dc44593563eeb62c541b, type: 3}
    autoAdvanceDelay: 3
  playOnce: 0

  lines:
  - speakerName: Sandman
    text: Hm...
    voiceClip: {fileID: 8300000, guid: 37a3ef7ba856c924ab4a12fb17defc2a, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 1
  - speakerName: Sandman
    text: Aha! Power's coming back to my catcher.
    voiceClip: {fileID: 8300000, guid: ef768ca90ce89e54b8b04762bcf8e89b, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 3.5
  - speakerName: Sandman
    text: Seems its reacting to something nearby too...
    voiceClip: {fileID: 8300000, guid: eacb0978e8c4de24d9ab9e9a837a02b8, type: 3}
    portrait: {fileID: 756335442, guid: d11ad3ad237b1bf41b01d214c16c70b5, type: 3}
    autoAdvanceDelay: 4
  - speakerName: 
    text: 'Tip: Use space to jump, jump just when landing to preserve momentum.'
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    autoAdvanceDelay: 6

  lines:
  - speakerName: Pixie
    text: Oh my gosh we did it we did it we did it! Take that deception candles!
    voiceClip: {fileID: 8300000, guid: 99e619931f90fc140be7df3d698eeee2, type: 3}
    portrait: {fileID: -93987997, guid: 919e4b97ba3a84a4fb0e7b3cd07edd82, type: 3}
    autoAdvanceDelay: 4.5
  - speakerName: 
    text: Yes we did! Phew, my head hurts a little. Let's keep going, before Knightmare
      makes things worse.
    voiceClip: {fileID: 8300000, guid: b085eadbae3de8f4580d02e07bd496ea, type: 3}
